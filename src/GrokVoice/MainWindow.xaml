<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GrokVoice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GrokVoice"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="Murmur">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- One page layout for every section: a title, then cards. -->
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
            <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,20,0,6" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drawn on Mica; caption buttons stay system-drawn. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/TitleIcon.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Murmur" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dictation" Tag="Dictation">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE720;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dictionary" Tag="Dictionary">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Jeeves" Tag="Jeeves">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Usage" Tag="Usage">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Accounts" Tag="Accounts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <!-- Pages that scroll as a whole. -->
                <ScrollViewer x:Name="PageScroller">
                    <Grid MaxWidth="900" Padding="32,24,32,32" HorizontalAlignment="Stretch">

                        <!-- General -->
                        <StackPanel x:Name="GeneralPage" Spacing="4">
                            <TextBlock Text="General" Style="{StaticResource PageTitle}" />

                            <Border Padding="20,16" Margin="0,0,0,4" CornerRadius="{StaticResource OverlayCornerRadius}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="Assets/TitleIcon.png" Width="40" Height="40" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Hold Right Alt to dictate. Hold the Copilot key to talk to Jeeves."
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <InfoBar x:Name="KeyBar" IsClosable="False" />
                            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Last problem" IsClosable="True" />

                            <TextBlock Text="Keys" Style="{StaticResource GroupHeader}" />
                            <tk:SettingsCard Header="Right Alt dictates"
                                             Description="Hold to talk, double tap for hands-free.">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE92E;" /></tk:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="RightAltSwitch" Toggled="RightAltSwitch_Toggled" />
                            </tk:SettingsCard>
                            <tk:SettingsCard x:Name="CopilotKeyCard" Header="Copilot key"
                                             Description="Choose Murmur in Windows Settings."
                                             IsClickEnabled="True" Click="CopilotKeySettings_Click">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;" /></tk:SettingsCard.HeaderIcon>
                                <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsCard.ActionIcon>
                            </tk:SettingsCard>

                            <TextBlock Text="App" Style="{StaticResource GroupHeader}" />
                            <tk:SettingsCard Header="Start with Windows">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE768;" /></tk:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="StartupSwitch" Toggled="StartupSwitch_Toggled" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Show in taskbar" Description="The Murmur glyph left of Start.">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7C4;" /></tk:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="RestingSwitch" Toggled="RestingSwitch_Toggled" />
                            </tk:SettingsCard>
                        </StackPanel>

                        <!-- Dictation -->
                        <StackPanel x:Name="DictationPage" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Dictation" Style="{StaticResource PageTitle}" />

                            <tk:SettingsCard Header="Microphone">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE720;" /></tk:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="MicBox" MinWidth="240" MaxWidth="320" SelectionChanged="MicBox_SelectionChanged" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Language">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;" /></tk:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="LanguageBox" MinWidth="240" SelectionChanged="LanguageBox_SelectionChanged" />
                            </tk:SettingsCard>

                            <TextBlock Text="Clean-up" Style="{StaticResource GroupHeader}" />
                            <tk:SettingsCard Header="Clean up with Grok"
                                             Description="Fixes punctuation, filler words and names from your dictionary.">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></tk:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="PolishSwitch" Toggled="PolishSwitch_Toggled" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Match the app"
                                             Description="Full sentences in email, casual in chat, literal in code.">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A1;" /></tk:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="AppStyleSwitch" Toggled="AppStyleSwitch_Toggled" />
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Use what's on screen"
                                             Description="Reads the text near your cursor so names come out right.">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B3;" /></tk:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="ScreenSwitch" Toggled="ScreenSwitch_Toggled" />
                            </tk:SettingsCard>
                        </StackPanel>

                        <!-- Jeeves -->
                        <StackPanel x:Name="JeevesPage" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Jeeves" Style="{StaticResource PageTitle}" />
                            <tk:SettingsCard Header="Grok Bot account"
                                             Description="Holding the Copilot key sends what you say to your bot.">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;" /></tk:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ProgressRing x:Name="BotRing" Width="20" Height="20" IsActive="False" />
                                    <TextBlock x:Name="BotState" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="BotSignInButton" Click="BotSignIn_Click" />
                                </StackPanel>
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="Send to">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE99A;" /></tk:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="BotBox" MinWidth="240" DisplayMemberPath="Name"
                                              SelectionChanged="BotBox_SelectionChanged" />
                                    <Button Click="BotRefresh_Click" ToolTipService.ToolTip="Refresh the list">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </tk:SettingsCard>
                            <InfoBar x:Name="BotBar" IsClosable="True" />
                        </StackPanel>

                        <!-- Usage -->
                        <StackPanel x:Name="UsagePage" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Usage" Style="{StaticResource PageTitle}" />
                            <Border Padding="20,16" CornerRadius="{StaticResource OverlayCornerRadius}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid x:Name="UsageGrid" ColumnSpacing="24" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="UsageNote" Margin="2,8,2,0" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                                <Button Content="Export CSV…" Click="UsageExport_Click" />
                                <HyperlinkButton Content="xAI billing" NavigateUri="https://console.x.ai/" />
                                <HyperlinkButton Content="ElevenLabs usage" NavigateUri="https://elevenlabs.io/app/subscription" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Accounts -->
                        <StackPanel x:Name="AccountsPage" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />

                            <tk:SettingsCard Header="Speech to text">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE1D6;" /></tk:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="EngineBox" MinWidth="240" SelectionChanged="EngineBox_SelectionChanged">
                                    <ComboBoxItem Content="Grok (xAI)" Tag="grok" />
                                    <ComboBoxItem Content="ElevenLabs Scribe" Tag="elevenlabs" />
                                </ComboBox>
                            </tk:SettingsCard>

                            <tk:SettingsExpander Header="ElevenLabs key" Description="Speech to text.">
                                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></tk:SettingsExpander.HeaderIcon>
                                <TextBlock x:Name="ElevenKeyState" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                        <StackPanel Spacing="8">
                                            <PasswordBox x:Name="ElevenKeyBox" PlaceholderText="sk_…" KeyDown="ElevenKeyBox_KeyDown" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveElevenKey_Click" />
                                                <Button x:Name="RemoveElevenKeyButton" Content="Remove" Click="RemoveElevenKey_Click" />
                                                <HyperlinkButton Content="Get a key" NavigateUri="https://elevenlabs.io/app/settings/api-keys" />
                                            </StackPanel>
                                        </StackPanel>
                                    </tk:SettingsCard>
                                </tk:SettingsExpander.Items>
                            </tk:SettingsExpander>

                            <tk:SettingsExpander x:Name="ApiKeyExpander" Header="xAI key" Description="Clean-up, and Grok speech to text.">
                                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></tk:SettingsExpander.HeaderIcon>
                                <TextBlock x:Name="ApiKeyState" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                        <StackPanel Spacing="8">
                                            <PasswordBox x:Name="ApiKeyBox" PlaceholderText="xai-…" KeyDown="ApiKeyBox_KeyDown" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveKey_Click" />
                                                <Button x:Name="RemoveKeyButton" Content="Remove" Click="RemoveKey_Click" />
                                                <ProgressRing x:Name="TestRing" Width="20" Height="20" IsActive="False" />
                                                <HyperlinkButton Content="Get a key" NavigateUri="https://console.x.ai/" />
                                            </StackPanel>
                                        </StackPanel>
                                    </tk:SettingsCard>
                                </tk:SettingsExpander.Items>
                            </tk:SettingsExpander>
                            <InfoBar x:Name="TestBar" IsClosable="True" />
                        </StackPanel>

                        <!-- About -->
                        <StackPanel x:Name="AboutPage" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                            <tk:SettingsCard x:Name="UpdatesCard" Header="Murmur">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;" /></tk:SettingsCard.HeaderIcon>
                                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" />
                            </tk:SettingsCard>
                            <tk:SettingsExpander Header="Last dictation">
                                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE81C;" /></tk:SettingsExpander.HeaderIcon>
                                <Button Content="Copy" Click="CopyLast_Click" />
                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                                        <TextBlock x:Name="LastText" Text="Nothing yet." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </tk:SettingsCard>
                                </tk:SettingsExpander.Items>
                            </tk:SettingsExpander>
                            <tk:SettingsExpander Header="Log">
                                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></tk:SettingsExpander.HeaderIcon>
                                <Button Content="Copy" Click="CopyLog_Click" />
                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                        <ListView x:Name="LogList" MaxHeight="320" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </tk:SettingsCard>
                                </tk:SettingsExpander.Items>
                            </tk:SettingsExpander>
                            <tk:SettingsCard Header="Quit Murmur" Description="Closing this window keeps Murmur running.">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsCard.HeaderIcon>
                                <Button Content="Quit" Click="Quit_Click" />
                            </tk:SettingsCard>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Dictionary: its own layout, so the list scrolls (and virtualizes) on its own. -->
                <Grid x:Name="DictionaryPage" Visibility="Collapsed" MaxWidth="900" Padding="32,24,32,24"
                      HorizontalAlignment="Stretch" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dictionary" Style="{StaticResource TitleTextBlockStyle}" />
                        <AutoSuggestBox x:Name="DictionarySearch" Grid.Column="1" Width="220" PlaceholderText="Search"
                                        AutomationProperties.Name="Search the dictionary"
                                        QueryIcon="Find" VerticalAlignment="Center" TextChanged="DictionarySearch_TextChanged" />
                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="AddEntry_Click" VerticalAlignment="Center"
                                AutomationProperties.Name="Add">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" VerticalAlignment="Center" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="WisprImportButton" Text="Import from Wispr Flow" Click="WisprImport_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Import file…" Click="DictionaryFile_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Remove everything…" Click="ClearDictionary_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <SelectorBar x:Name="DictionaryFilter" SelectionChanged="DictionaryFilter_SelectionChanged">
                            <SelectorBarItem x:Name="FilterAll" Text="All" Tag="all" IsSelected="True" />
                            <SelectorBarItem x:Name="FilterWords" Text="Words" Tag="words" />
                            <SelectorBarItem x:Name="FilterReplacements" Text="Replacements" Tag="replacements" />
                            <SelectorBarItem x:Name="FilterSnippets" Text="Snippets" Tag="snippets" />
                        </SelectorBar>
                    </Grid>

                    <InfoBar x:Name="DictionaryBar" Grid.Row="2" IsClosable="True" />

                    <Grid Grid.Row="3">
                        <ListView x:Name="DictionaryList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="DictionaryList_ItemClick" Padding="0,0,0,8">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DictionaryRow">
                                    <Grid Padding="16,10,8,10" ColumnSpacing="12" MinHeight="52"
                                          CornerRadius="{StaticResource ControlCornerRadius}"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Phrase}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Kind}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Button Grid.Column="2" Click="DeleteEntry_Click" Background="Transparent" BorderThickness="0"
                                                VerticalAlignment="Center" ToolTipService.ToolTip="Remove"
                                                AutomationProperties.Name="{x:Bind RemoveName}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="DictionaryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE82D;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="DictionaryEmptyText" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
