<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GrokVoice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="Grok Voice">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drawn on Mica; caption buttons stay system-drawn. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/Square44x44Logo.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Grok Voice" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="1000" Padding="36,8,36,36" Spacing="4" HorizontalAlignment="Stretch">

                <TextBlock Text="Grok Voice" Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- How to use it, and what state it's in right now. -->
                <Border Padding="20" Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE720;" FontSize="32" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Hold Right Alt and talk, then let go: the text is typed where your cursor is. Double tap Right Alt for hands-free, tap again to finish, Esc cancels. Hold the Copilot key to give your main bot an instruction; tap it to open Grok Bot."
                                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="KeyBar" IsClosable="False" />
                <InfoBar x:Name="ErrorBar" Severity="Error" Title="Last problem" IsClosable="True" />

                <!-- Grok -->
                <TextBlock Text="Grok" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsExpander x:Name="ApiKeyExpander" Header="xAI API key" IsExpanded="True"
                                     Description="Your voice is sent to xAI's speech-to-text. Billed to your xAI account at about $0.20 per hour of audio.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="ApiKeyState" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <StackPanel Spacing="8">
                                <PasswordBox x:Name="ApiKeyBox" PlaceholderText="xai-…" MinWidth="320"
                                             KeyDown="ApiKeyBox_KeyDown" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SaveKeyButton" Content="Save" Style="{StaticResource AccentButtonStyle}"
                                            Click="SaveKey_Click" />
                                    <Button x:Name="TestKeyButton" Content="Test connection" Click="TestKey_Click" />
                                    <Button x:Name="RemoveKeyButton" Content="Remove" Click="RemoveKey_Click" />
                                    <ProgressRing x:Name="TestRing" Width="20" Height="20" IsActive="False" />
                                </StackPanel>
                                <HyperlinkButton Content="Create a key in the xAI console" Padding="0"
                                                 NavigateUri="https://console.x.ai/" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <InfoBar x:Name="TestBar" IsClosable="True" />

                <tk:SettingsCard Header="Language"
                                 Description="Picking your language lets Grok format numbers and dates. Auto-detect works for mixed languages.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="LanguageBox" MinWidth="180" SelectionChanged="LanguageBox_SelectionChanged" />
                </tk:SettingsCard>

                <!-- Microphone -->
                <TextBlock Text="Microphone" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard Header="Catch the first words"
                                 Description="Keeps the microphone open in the background so nothing is lost while it waits to see that you're holding the key. Audio stays in memory and is thrown away unless you dictate. The microphone-in-use icon stays on.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE1D6;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="WarmMicSwitch" Toggled="WarmMicSwitch_Toggled" />
                </tk:SettingsCard>

                <tk:SettingsCard Header="Microphone privacy" Description="Choose which microphone Windows uses, and allow Grok Voice to use it."
                                 IsClickEnabled="True" Click="MicPrivacy_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <!-- Keys -->
                <TextBlock Text="Keys" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard Header="Right Alt dictates at the cursor"
                                 Description="Hold to talk, double tap for hands-free. Right Alt shortcuts still work. Wispr Flow also uses Right Alt, so quit it or move it to another key.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE92E;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="RightAltSwitch" Toggled="RightAltSwitch_Toggled" />
                </tk:SettingsCard>

                <tk:SettingsCard x:Name="CopilotKeyCard" Header="Customize Copilot key"
                                 Description="Choose Grok Voice under Personalization > Text input."
                                 IsClickEnabled="True" Click="CopilotKeySettings_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <tk:SettingsExpander x:Name="BotExpander" Header="Main bot" IsExpanded="True"
                                     Description="Holding the Copilot key sends what you say to this Grok Bot. Signs in with Cursor, like the Grok Bot app.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE99A;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing x:Name="BotRing" Width="20" Height="20" IsActive="False" />
                        <TextBlock x:Name="BotState" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="BotSignInButton" Click="BotSignIn_Click" />
                    </StackPanel>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Send instructions to">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="BotBox" MinWidth="220" DisplayMemberPath="Name"
                                          SelectionChanged="BotBox_SelectionChanged" />
                                <Button Click="BotRefresh_Click" ToolTipService.ToolTip="Refresh">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <InfoBar x:Name="BotBar" IsClosable="True" />

                <!-- General -->
                <TextBlock Text="General" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard Header="Start with Windows"
                                 Description="Run Grok Voice in the background when you sign in, so the keys work right away.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE768;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupSwitch" Toggled="StartupSwitch_Toggled" />
                </tk:SettingsCard>

                <tk:SettingsExpander Header="Last dictation" Description="What Grok Voice heard most recently.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <Button Content="Copy" Click="CopyLast_Click" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <TextBlock x:Name="LastText" Text="Nothing yet." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsExpander Header="Diagnostics" Description="Key presses, timings and errors from this session.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <Button Content="Copy log" Click="CopyLog_Click" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <ListView x:Name="LogList" MaxHeight="280" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsCard Header="Quit Grok Voice"
                                 Description="Closing this window keeps Grok Voice running for the keys. Quit stops it until you open it again.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button Content="Quit" Click="Quit_Click" />
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
