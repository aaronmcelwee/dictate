<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 rescap">

  <!-- Publisher must match the subject of the signing certificate (see scripts/New-DevCert.ps1). -->
  <Identity Name="GrokVoice" Publisher="CN=Dictate Dev" Version="0.1.0.0" />

  <Properties>
    <DisplayName>Grok Voice</DisplayName>
    <PublisherDisplayName>Grok Voice</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Grok Voice"
        Description="Hold Right Alt to dictate anywhere; hold the Copilot key to instruct your Grok Bot."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="grokvoice-key">
            <uap:DisplayName>Grok Voice Copilot key events</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Off until the user turns on "Start with Windows" in Grok Voice's settings. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="GrokVoiceStartup" Enabled="false" DisplayName="Grok Voice" />
        </uap5:Extension>

        <!-- Makes Grok Voice selectable in Settings > Personalization > Text input > Customize Copilot key. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.copilotkeyprovider"
            Id="GrokVoice"
            DisplayName="Grok Voice"
            Description="Tap to open Grok Bot, hold to give your main bot an instruction"
            PublicFolder="Public">
            <uap3:Properties>
              <SingleTap MessageWParam="0">grokvoice-key://?state=Tap</SingleTap>
              <PressAndHoldStart MessageWParam="1">grokvoice-key://?state=Down</PressAndHoldStart>
              <PressAndHoldStop MessageWParam="2">grokvoice-key://?state=Up</PressAndHoldStop>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
