<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GrokVoice.RecordingPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Grok Voice">

    <!-- A small dark capsule: just a live waveform while listening, growing to fit a message. -->
    <Border x:Name="Root" Background="#FF121212" CornerRadius="18" Padding="12,0,14,0">
        <Grid x:Name="Body" ColumnSpacing="10" VerticalAlignment="Center" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Badge: the bot's character clip, a glyph, or nothing. -->
            <Grid x:Name="Badge" Width="24" Height="24" VerticalAlignment="Center" Visibility="Collapsed">
                <Border x:Name="AvatarFrame" CornerRadius="12" Visibility="Collapsed">
                    <Grid>
                        <MediaPlayerElement x:Name="Avatar" Stretch="UniformToFill" AreTransportControlsEnabled="False" />
                        <!-- Video isn't clipped by rounded corners, so paint the pill's colour outside the circle. -->
                        <Path Fill="#FF121212" IsHitTestVisible="False">
                            <Path.Data>
                                <GeometryGroup FillRule="EvenOdd">
                                    <RectangleGeometry Rect="-1,-1,26,26" />
                                    <EllipseGeometry Center="12,12" RadiusX="11.5" RadiusY="11.5" />
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </Grid>
                </Border>
                <FontIcon x:Name="BadgeGlyph" FontSize="14" Foreground="White" Visibility="Collapsed" />
            </Grid>

            <!-- Waveform: bars that follow the voice, centred. -->
            <StackPanel x:Name="Wave" Grid.Column="1" Orientation="Horizontal" Spacing="3"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" />

            <!-- Message: a title line and, for replies, the whole formatted answer (scrolls when long). -->
            <StackPanel x:Name="Message" Grid.Column="1" VerticalAlignment="Center" Spacing="3" Visibility="Collapsed">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <RichTextBlock x:Name="BodyRich" FontSize="13.5" LineHeight="20" Foreground="#FFD0D0D0"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="False" Margin="0,0,6,0" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</Window>
